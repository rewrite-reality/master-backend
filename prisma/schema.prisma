datasource db {
  provider = "postgresql"
  // url удаляем! Теперь он задается в prisma.config.ts
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS (Business Logic Constants)
// ------------------------------------------------------

enum Role {
  MANAGER // Менеджер (вход через логин/пароль или SSO)
  MASTER // Мастер (вход через Telegram Mini App)
  ADMIN // Супер-админ
}

enum MasterStatus {
  PENDING // Регистрация, ждет апрува
  ACTIVE // Работает
  BLOCKED // Бан (жалобы, фрод)
  ON_LEAVE // В отпуске (не участвует в гонках)
}

enum OrderStatus {
  PENDING // 1. Поиск исполнителя (Race Mode)
  ASSIGNED // 2. Мастер найден, едет
  ARRIVED // 3. Мастер на месте (опционально)
  IN_PROGRESS // 4. Работает
  REVIEW // 5. В ожидании проверки менеджером
  COMPLETED // 6. Успешно завершено
  CANCELLED // 7. Отмена клиентом/менеджером
  DISPUTE // 8. Проблема (мастер не приехал, клиент недоволен)
}

enum DispatchMode {
  MANUAL // Ручное назначение менеджером
  RACE // "Гонка": кто первый нажал, того и заказ
}

enum PaymentType {
  CASH
  CARD_ONLINE
  TRANSFER
}

enum IntegrationProvider {
  AMOCRM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum OutboxEventType {
  AMOCRM_LEAD_MOVE
}

enum PayoutType {
  EARNING // начисление за выполненный заказ
  ADJUSTMENT // ручная корректировка (на будущее)
  WITHDRAWAL // вывод (на будущее)
}

enum PayoutStatus {
  POSTED // проведено (увеличило баланс)
  REVERSED // отменено (на будущее)
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model Payout {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  masterId String
  master   MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type   PayoutType   @default(EARNING)
  status PayoutStatus @default(POSTED)

  /// Сумма начисления мастеру
  amount Decimal @db.Decimal(10, 2)

  /// Процент, по которому посчитали (фиксируем на момент выплаты)
  percent Int

  /// Доп. данные (на будущее)
  meta Json?

  /// Идемпотентность: за один заказ — одно начисление (ключевой момент!)
  @@unique([orderId])
  @@index([masterId, createdAt])
  @@map("payouts")
}

model IntegrationOutbox {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider IntegrationProvider
  type     OutboxEventType
  status   OutboxStatus        @default(PENDING)

  // Связь с заказом
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Для Amo
  amoLeadId String
  payload   Json

  // Дедуп: один и тот же апдейт не плодим
  dedupeKey String @unique

  // Ретраи
  attempts    Int      @default(0)
  nextRetryAt DateTime @default(now())
  lastError   String?

  @@index([status, nextRetryAt])
  @@index([orderId])
  @@map("integration_outbox")
}

// Справочник районов (чтобы не хардкодить строки)
model District {
  id       String  @id @default(uuid())
  name     String // "Центральный", "Ленинский"
  city     String  @default("Chelyabinsk")
  isActive Boolean @default(true) // Можно временно отключить район

  masters MasterDistrict[] // Связь многие-ко-многим с мастерами
  orders  Order[] // Заказы в этом районе

  @@unique([city, name]) // Нельзя создать два "Центральных" в одном городе
  @@map("districts")
}

// Справочник специальностей (Сантехник, Электрик...)
model Specialty {
  id       String  @id @default(uuid())
  name     String // "Сантехник"
  code     String  @unique // "plumber" (для кода/иконок)
  isActive Boolean @default(true)

  masters MasterSpecialty[]
  orders  Order[] // Заказы этой специальности

  @@map("specialties")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Auth & Identity ---
  role Role @default(MASTER)

  // Telegram (для Мастеров)
  telegramId       BigInt? @unique // BigInt, т.к. ID может быть > 2^31
  telegramUsername String?
  telegramChatId   BigInt? // Для отправки уведомлений (может отличаться от ID пользователя)

  // Login/Pass (для Менеджеров/Админов)
  email        String? @unique
  passwordHash String? // Argon2 hash

  // --- Relations ---
  masterProfile MasterProfile?

  // Logs & Audits
  actions AuditLog[] // Что делал этот юзер

  @@index([telegramId])
  @@map("users")
}

model MasterProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String // Иван
  lastName   String // Иванов
  patronymic String? // Иванович (может не быть)
  phone      String // Телефон для связи с менеджером (не клиента!)

  status      MasterStatus @default(PENDING)
  rating      Float        @default(5.0) // 1.0 - 5.0
  reviewCount Int          @default(0)

  balance Decimal @default(0) @db.Decimal(10, 2)

  /// Процент выплаты мастеру (по умолчанию 50%)
  payoutPercent Int @default(50)

  // Настройки "Гонки"
  autoAccept Boolean @default(false) // Авто-принятие (на будущее)

  // Связь с районами
  districts MasterDistrict[]

  // Связь со специальностями
  specialties MasterSpecialty[]

  payouts Payout[] // <-- добавь (см. модель ниже)

  orders Order[] // История заказов

  @@map("master_profiles")
}

// Таблица связи "Мастер <-> Район" (Many-to-Many explicit)
model MasterDistrict {
  masterId String
  master   MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([masterId, districtId])
  @@map("masters_districts")
}

// Таблица связи "Мастер <-> Специальность" (Many-to-Many explicit)
model MasterSpecialty {
  masterId String
  master   MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([masterId, specialtyId])
  @@map("master_specialties")
}

model Order {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- AmoCRM Integration (Source of Truth link) ---
  amoLeadId     String? @unique // ID сделки (Leads). Уникально!
  amoContactId  String? // ID контакта
  amoPipelineId String? // ID воронки
  amoLink       String? // Ссылка на CRM для удобства

  // --- Order Details ---
  status       OrderStatus  @default(PENDING)
  dispatchMode DispatchMode @default(RACE)

  // Локация
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  city       String   @default("Chelyabinsk") // Чтобы не путать улицы
  street     String // "Ленина"
  house      String // "15а"
  lat        Float?
  lon        Float?
  entrance   String? // "1" (Подъезд) - нужно мастеру!
  floor      String? // "5" (Этаж) - нужно, если лифта нет
  apartment  String? // "12" (Квартира)
  intercom   String? // "12К" (Домофон)

  // Специальность (ОБЯЗАТЕЛЬНО!)
  specialtyId String? // Сделал опциональным только для совместимости, но логически должно быть обязательным
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])

  // Суть работы
  title       String // "Починить кран" (Заголовок из Amo)
  description String      @db.Text // Подробности
  price       Decimal?    @db.Decimal(10, 2) // Цена работ (предварительная)
  paymentType PaymentType @default(CASH)
  proofPhotos String[]    @default([])

  // Данные клиента (Скрыты от мастера до назначения)
  clientName  String?
  clientPhone String? // "+7900..."

  // Время
  scheduledAt DateTime? // Желаемое время (null = сейчас)
  deadlineAt  DateTime? // Крайний срок (для SLA)

  // --- Relations ---
  masterId String?
  master   MasterProfile? @relation(fields: [masterId], references: [id])

  payout Payout? // <-- добавь (один заказ -> одна выплата)

  // История изменений (кто принял, когда закрыл)
  logs OrderLog[]

  outbox IntegrationOutbox[]

  @@index([status])
  @@index([amoLeadId])
  @@index([districtId])
  @@index([specialtyId])
  @@map("orders")
}

// ------------------------------------------------------
// LOGS & AUDIT (Безопасность и отладка)
// ------------------------------------------------------

model OrderLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  message String // "Статус изменен на ASSIGNED"
  meta    Json? // { "prevStatus": "PENDING", "masterId": "..." }

  @@map("order_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action  String // "LOGIN", "ACCEPT_ORDER", "CHANGE_PROFILE"
  ip      String?
  details Json? // { "userAgent": "..." }

  @@map("audit_logs")
}

// Лог вебхуков (сырые данные для разбора полетов)
model IntegrationEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  source    String // "AMOCRM"
  direction String // "INCOMING"
  event     String // "leads.status_update"

  payload   Json // Весь JSON, который пришел
  error     String? // Если упало при обработке
  isSuccess Boolean @default(true)

  @@index([createdAt])
  @@map("integration_events")
}
